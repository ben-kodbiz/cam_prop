# Copy to .env and adjust. Never commit real secrets.

# Local LLM (OpenAI-compatible endpoint). Optional in Phase 1.
OE_LLM_PROVIDER=local
OE_LLM_ENDPOINT=http://localhost:1234/v1
OE_LLM_MODEL=
OE_LLM_API_KEY=

# SQLite database location
OE_DB_PATH=data/evidence.db

# Public site base URL (used for canonical URLs in exports)
OE_SITE_URL=https://example.github.io/open-evidence
